{{- $choices := list "home" "work" -}}
{{- $hosttype := promptChoice "What type of host are you on" $choices -}}

{{/* Resolve distro family.
     - Pop!_OS and Aurora each get their own family so their task trees in
       dot_ansible/tasks/{pop,aurora} are routed explicitly.
     - Fedora Kinoite → "kinoite". Aurora is ublue-os's KDE remix of Kinoite
       (their Containerfile is FROM quay.io/fedora/fedora-kinoite) so the
       two are architecturally identical, but we keep them in separate task
       trees for explicit visibility rather than branching on a variant flag.
     - Otherwise pick the first known ID_LIKE entry. */}}
{{- $rawId := get .chezmoi.osRelease "id" -}}
{{- $rawVariant := or (get .chezmoi.osRelease "variantId") "" -}}
{{- $rawIdLike := or (get .chezmoi.osRelease "idLike") $rawId -}}
{{- $idLike := $rawIdLike -}}
{{- if eq $rawId "pop" -}}
  {{- $idLike = "pop" -}}
{{- else if or (eq $rawId "aurora") (and (eq $rawId "fedora") (eq $rawVariant "aurora")) -}}
  {{- $idLike = "aurora" -}}
{{- else if and (eq $rawId "fedora") (eq $rawVariant "kinoite") -}}
  {{- $idLike = "kinoite" -}}
{{- else -}}
  {{- range (splitList " " $rawIdLike) -}}
    {{- if or (eq . "arch") (eq . "fedora") -}}
      {{- $idLike = . -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

diff:
  exclude:
    - scripts

data:
  os:
    idLike: {{ $idLike }}
  hosttype: {{ $hosttype }}
  wsl: false
