    - scripts

encryption: age
age:
  identity: "~/.config/chezmoi/key.txt"
  recipient: "age1vw9nz2fmkpgmqsnpdtuxmnvkfnln7u9u5rmty9q8796entam69zsygjtkl"

data:
  os:
    idLike: {{ or (get .chezmoi.osRelease "idLike") (get .chezmoi.osRelease "id") .chezmoi.os }}
  hosttype: {{ $hosttype }}
  wsl: false
