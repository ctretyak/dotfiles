# Headless Lazy.nvim sync. Idempotent via creates-check.
#
# Absolute brew path: /etc/profile.d/brew.sh exports the brew prefix only
# in interactive shells (`$- == *i*`), and ansible's command module spawns
# a non-interactive subprocess. Relying on PATH inheritance from the user
# shell that launched chezmoi works only by accident — pinning the path
# is the contract.

- name: neovim-plugins | Install Neovim plugins
  ansible.builtin.command: /home/linuxbrew/.linuxbrew/bin/nvim --headless "+Lazy! sync" +qa
  args:
    creates: "{{ .chezmoi.homeDir }}/.local/share/nvim/lazy"
