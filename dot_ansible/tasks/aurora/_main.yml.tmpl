# Aurora (ublue-os KDE) task chain.
#
# Aurora extends Fedora Kinoite (FROM quay.io/fedora/fedora-kinoite) with
# codecs, brew, Flathub (with filters), and daily rebuilds. Base image
# already ships: zsh, tmux, git, gcc, distrobox, podman-docker, ptyxis,
# fastfetch, htop, glow, gum, just, kate — see build_files/base/01-packages.sh.
#
# Install model on Aurora (ublue philosophy: brew + flatpak over rpm-ostree;
# rpm-ostree layering is "last resort" per Aurora's own docs):
#   - rpm-ostree: only what brew can't cleanly cover (zsh plugins, g++)
#   - brew (preinstalled): dev CLI. Updates are handled by ublue's
#     uupd.timer, which on Aurora supplants rpm-ostreed-automatic +
#     flatpak-system-update + brew-upgrade.timer (the brew-upgrade unit
#     isn't even shipped here; uupd shells `brew upgrade` itself).
#   - flatpak: all GUI apps. Flathub is preconfigured two ways: a static
#     /etc/flatpak/remotes.d/flathub.flatpakrepo (always present) and
#     ublue's flatpak-add-flathub-repos.service (one-shot first-boot,
#     guarded by ConditionPathExists on a marker file). Either way, we
#     don't re-add the remote.
#   - rpm-ostree for VS Code: Microsoft's yum repo, since the Flatpak sandbox
#     breaks Remote-SSH / Remote-Containers / debug adapters
#   - HOME installers: Claude Code via official curl|bash into ~/.local/bin

- import_tasks: host-packages.yml
- import_tasks: brew-packages.yml
- import_tasks: fonts.yml
- import_tasks: ptyxis.yml
- import_tasks: touchpad.yml
- import_tasks: systray.yml
- import_tasks: pager.yml
- import_tasks: taskbar.yml
- import_tasks: kwin-shortcuts.yml
- import_tasks: spectacle.yml
- import_tasks: nvm.yml
- import_tasks: claude-code.yml
- import_tasks: claude-code-plugins.yml

- import_tasks: keepassxc.yml
- import_tasks: google-chrome.yml
- import_tasks: default-browser.yml
- import_tasks: telegram.yml
- import_tasks: spotify.yml
- import_tasks: obsidian.yml
- import_tasks: ticktick.yml
- import_tasks: insync.yml
- import_tasks: vscode.yml
{{ if eq .hosttype "work" }}
- import_tasks: bruno.yml
- import_tasks: dbeaver.yml
{{ end }}
{{ if eq .hosttype "home" }}
- import_tasks: steam.yml
{{ end }}

- import_tasks: tmux-plugins.yml
- import_tasks: neovim-plugins.yml
