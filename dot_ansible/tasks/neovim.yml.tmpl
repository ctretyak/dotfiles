{{ if or (eq (get .chezmoi.osRelease "id") "popos") (eq (get .chezmoi.osRelease "id") "ubuntu") }}

- name: Install Neovim
  become: true
  snap:
    name: nvim
    classic: true

- name: Install Neovim - Build essential
  become: true
  package:
    name: 
      - build-essential
      - wl-clipboard

{{ else if eq .chezmoi.os "darwin" }}

- name: Install Neovim
  homebrew:
    name: neovim
    state: present

{{ else }}

- name: Install Neovim
  become: true
  package:
    name: neovim

{{ end }}

{{ if eq (get .chezmoi.osRelease "id") "fedora" }}

- name: Enable lazygit COPR
  become: true
  command: dnf copr enable atim/lazygit -y
  args:
    creates: /etc/yum.repos.d/_copr:copr.fedorainfracloud.org:atim:lazygit.repo

- name: Install development-tools group
  become: true
  shell: dnf group install -y development-tools
  args:
    creates: /usr/bin/gcc

- name: Install development tools
  become: true
  package:
    name:
      - gcc
      - make
      - kernel-devel
      - glibc-devel
      - autoconf
      - automake
      - libtool
      - which
    state: present

{{ end }}


{{ if eq (get .chezmoi.osRelease "id") "arch" }}

- name: Install Neovim dependencies
  become: true
  package:
    name:
      - fd
      - wl-clipboard

{{ else if eq .chezmoi.os "darwin" }}

- name: Install Neovim dependencies
  homebrew:
    name:
      - fd
      - ripgrep
      - fzf
    state: present

{{ else }}

- name: Install Neovim dependencies
  become: true
  package:
    name:
      - fd-find

{{ end }}

{{ if eq .chezmoi.os "darwin" }}

- name: Install Neovim dependencies
  homebrew:
    name:
      - lazygit
    state: present

{{ else }}

- name: Install Neovim dependencies
  become: true
  package:
    name:
{{ if ne (get .chezmoi.osRelease "versionCodename") "noble" }} # it available after ubuntu 25
      - lazygit
{{ end }}
      - ripgrep
      - fzf

{{ end }}

