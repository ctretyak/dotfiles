{{ if eq .os.idLike "arch" }}

- name: Install GnuPG
  become: true
  package:
    name: gnupg

{{ else if eq .chezmoi.os "darwin" }}

- name: Install GnuPG
  homebrew:
    name: gnupg
    state: present

{{ else if eq .os.idLike "windows" }}

- name: Install Gpg4win
  win_chocolatey:
    name: gpg4win

{{ else }}

- name: Install GnuPG
  become: true
  package:
    name: gpg

{{ end }}
