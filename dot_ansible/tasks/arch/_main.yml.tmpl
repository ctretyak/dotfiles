- name: Create the `aur_builder` user
  become: yes
  ansible.builtin.user:
    name: aur_builder
    create_home: yes
    group: wheel
- name: Allow the `aur_builder` user to run `sudo pacman` without a password
  become: yes
  ansible.builtin.lineinfile:
    path: /etc/sudoers.d/11-install-aur_builder
    line: "aur_builder ALL=(ALL) NOPASSWD: /usr/bin/pacman"
    create: yes
    mode: 0644
    validate: "visudo -cf %s"

- name: Install bc
  become: true
  package:
    name: bc

- name: Install cronie
  pacman:
    name: cronie
- name: Enable cronie service
  systemd:
    name: cronie
    enabled: true
    state: started

- name: Install SimpleScan
  become: true
  package:
    name: simple-scan

- name: Install paru
  become: true
  package:
    name: paru

- name: Enable bluetooth service
  become: true
  systemd:
    name: bluetooth.service
    enabled: yes
    state: started

- name: Install GnuPG
  become: true
  package:
    name: gnupg

- name: Install Docker
  become: true
  package:
    name:
      - docker
      - docker-compose

- name: Enable Docker service
  become: true
  systemd:
    name: docker
    enabled: true
    state: started

- name: Install Google Chrome
  kewlfft.aur.aur:
    name: google-chrome

- name: Install Neovim
  become: true
  package:
    name:
      - neovim
      - fd
      - wl-clipboard
      - lazygit
      - ripgrep
      - fzf

- name: Install packages
  become: true
  package:
    name:
      - obsidian
      - telegram-desktop
      - spotify

- name: Install TickTick
  kewlfft.aur.aur:
    name: ticktick

{{ if eq .hosttype "work" }}
- name: Install Bruno
  kewlfft.aur.aur:
    name: bruno

- name: Install DBeaver
  kewlfft.aur.aur:
    name: dbeaver
{{ end }}

{{ if eq .hosttype "home" }}
- name: Install Steam
  become: true
  package:
    name: steam
{{ end }}
