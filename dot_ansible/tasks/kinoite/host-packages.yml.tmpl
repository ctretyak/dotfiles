# Kinoite / Aurora host layer via rpm-ostree.
#
# Kinoite: everything dev-related lives on the host — shell, CLI, editor,
# dev runtimes. No brew in base image, so rpm-ostree is the natural choice.
#
# Aurora: base image already ships zsh, tmux, git, fastfetch, htop, distrobox,
# podman-docker, ptyxis, etc. Homebrew is also preinstalled, and ublue's
# philosophy prefers brew + flatpak over rpm-ostree layering. So the Aurora
# branch layers only what brew can't cleanly cover:
#   - zsh plugins (system-sourced from /usr/share/zsh/site-functions)
#   - C/C++ toolchain (brew's gcc is huge; Fedora gcc is ~80 MB layered)

- name: Check currently layered packages
  ansible.builtin.command: rpm-ostree status --json
  register: ostree_status
  changed_when: false

- name: Compute required host layers
  ansible.builtin.set_fact:
    required_layers:
{{ if eq (or (get .os "variant") "") "aurora" }}
      # Aurora: minimal layer — defer dev CLI to brew
      - zsh-syntax-highlighting
      - zsh-autosuggestions
      - gcc
      - gcc-c++
      - make
{{ else }}
      # Kinoite: full stack via rpm-ostree
      # Shell
      - zsh
      - zsh-syntax-highlighting
      - zsh-autosuggestions
      - tmux
      # CLI utilities
      - bc
      - jq
      - git
      - ripgrep
      - fd-find
      - fzf
      - lazygit
      - wl-clipboard
      # Editor + dev runtimes
      - neovim
      - nodejs
      - npm
      - python3-pip
      - gcc
      - gcc-c++
      - make
{{ end }}

- name: Determine missing layers
  ansible.builtin.set_fact:
    missing_layers: >-
      {{`{{ required_layers
         | reject('in', (ostree_status.stdout | from_json).deployments[0].packages | default([]))
         | list }}`}}

- name: Layer missing host packages via rpm-ostree
  become: true
  ansible.builtin.command: >
    rpm-ostree install --idempotent --assumeyes {{`{{ missing_layers | join(' ') }}`}}
  when: missing_layers | length > 0
  register: rpm_ostree_install

- name: Notify about staged deployment
  ansible.builtin.debug:
    msg: >
      Host packages layered into the next deployment: {{`{{ missing_layers | join(', ') }}`}}.
      Reboot to activate them. Re-run 'chezmoi apply' after reboot to continue.
  when: missing_layers | length > 0

- name: Set zsh as default shell
  become: true
  ansible.builtin.user:
    name: "{{`{{ lookup('env', 'USER') }}`}}"
    shell: /usr/bin/zsh
  when: missing_layers | length == 0
