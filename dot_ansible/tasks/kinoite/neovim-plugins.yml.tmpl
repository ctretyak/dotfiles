# Headless Lazy.nvim sync. Idempotent via creates-check.
# Neovim binary: rpm-ostree on Kinoite, brew on Aurora.
# On Aurora the brew shim is in /home/linuxbrew/.linuxbrew/bin which is
# expected to be in PATH via Aurora's /etc/zsh/zshrc brew shellenv init.

- name: Install Neovim plugins
  ansible.builtin.command: nvim --headless "+Lazy! sync" +qa
  args:
    creates: "{{ .chezmoi.homeDir }}/.local/share/nvim/lazy"
