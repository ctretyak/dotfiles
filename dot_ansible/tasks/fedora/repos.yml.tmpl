- name: repos | Gather OS facts
  setup:
    gather_subset: min

- name: repos | Add rpmfusion-free repo
  become: true
  dnf:
    name: "https://download1.rpmfusion.org/free/fedora/rpmfusion-free-release-{{ "{{" }} ansible_facts['distribution_major_version'] {{ "}}" }}.noarch.rpm"
    disable_gpg_check: true

{{ if eq .hosttype "work" }}
- name: repos | Enable SSH service
  become: true
  systemd:
    name: sshd
    enabled: yes
    state: started
{{ end }}
