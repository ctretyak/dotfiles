{{ if eq .os.idLike "fedora" }}

- name: Install Discord
  community.general.flatpak:
    name: com.discordapp.Discord

{{ else if eq .chezmoi.osRelease.id "ubuntu" }}

- name: Install Discord
  become: true
  snap:
    name: discord

{{ else }}

- name: Install Discord
  become: true
  package:
    name: discord

{{ end }}
