<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Refreshes GitLab MR numbers in the herdr sidebar every 5 minutes. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.herdr.glab-mr</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>mr.sh</string>
    <string>all</string>
  </array>
  <key>WorkingDirectory</key>
  <string>{{ .chezmoi.homeDir }}/.config/herdr/local-plugins/glab-mr</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
