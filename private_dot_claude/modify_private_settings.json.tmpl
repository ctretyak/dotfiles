#!/bin/bash
# chezmoi modify_ script for ~/.claude/settings.json.
#
# chezmoi does not own the whole file. It keeps a "managed" block (below) whose
# entries are applied over the machine's current settings.json by path: each entry
# key names a path (dot-separated for nesting) and its value replaces exactly that
# path, leaving everything else the machine has untouched. This lets each machine
# keep its own settings.json while a core set of keys stays synced from chezmoi.
#
# The managed block is the single source of truth for what syncs: add a key to
# sync it, delete a key to stop syncing it (the machine then keeps whatever it
# had — no stray nulls).
#
# Granularity is chosen per entry:
#   "theme": "auto"                  -> replaces the whole top-level "theme"
#   "permissions.defaultMode": "..." -> replaces only permissions.defaultMode and
#                                       keeps permissions.allow / deny / etc.
# Use a plain key when chezmoi should own the whole value; use a dotted path when
# a sub-key should be enforced but its siblings left machine-local.
#
# "enabledPlugins" is deliberately NOT managed: ansible (claude-code-plugins.yml)
# is the single source of truth for plugins; the `claude plugin install` CLI writes
# the enablement into settings.json locally and this merge leaves it alone.
#
# Hooks are deliberately NOT managed either: english-coach and rtk are plugins
# (ctretyak marketplace) and herdr writes its own SessionStart entry via
# `herdr integration install claude` (ansible). The inline hook entries that used
# to live here are removed one by one via $retired_hooks below, leaving any other
# hook on the machine alone.
#
# chezmoi passes the current target contents on stdin (empty on a fresh machine)
# and writes this script's stdout back to ~/.claude/settings.json.
set -euo pipefail

# The paths chezmoi owns and syncs across every machine. A dotted key targets a
# sub-key (env vars, permissions.defaultMode), keeping its machine-local siblings;
# a plain key owns the whole value. Any path not listed (enabledPlugins,
# extraKnownMarketplaces, MCP servers, permissions.allow, hooks, …) is left
# untouched.
managed=$(cat <<'JSON'
{
  "env.CLAUDE_CODE_AUTO_COMPACT_WINDOW": "500000",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions.defaultMode": "auto",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "refreshInterval": 120
  },
  "language": "English",
  "theme": "auto"
}
JSON
)

# Hook commands chezmoi used to put into settings.json and no longer should
# (they moved into plugins). Every hook whose command contains one of these
# substrings is removed, wherever it sits; groups, events and the "hooks" object
# are dropped once empty. Nothing else in hooks.* is touched, so machine-local
# hooks (herdr, hand-added ones) survive. Safe to keep forever: a no-op once the
# entries are gone. Drop the list once every machine has applied it.
retired_hooks='["/.claude/english-coach/coach-hook.sh", "/.claude/english-coach/coach-precompute.sh", "rtk hook claude"]'

existing="$(cat)"
[ -z "$existing" ] && existing='{}'

if command -v jq >/dev/null 2>&1; then
  # For each entry in $managed, split its key on "." into a path and set exactly
  # that path — replacing only the leaf while leaving its siblings untouched.
  # A plain key ("theme") replaces the whole top-level value; a dotted key
  # ("permissions.defaultMode") replaces just that sub-key and keeps the rest of
  # the object (permissions.allow, …). Any path not listed is never touched, so
  # deleting a key from the managed block simply stops syncing it — never null.
  # (Managed keys must not contain a literal "." in a single path segment.)
  # Then prune the retired hook commands (see $retired_hooks above).
  printf '%s' "$existing" | jq --argjson managed "$managed" --argjson retired "$retired_hooks" '
    reduce ($managed | to_entries[]) as $e (.; setpath($e.key | split("."); $e.value))
    | if (.hooks | type) == "object" then
        .hooks |= (
          map_values(
            if type == "array" then
              map(
                if (.hooks | type) == "array" then
                  .hooks |= map(select(
                    (.command // "") as $c | ($retired | any(. as $r | $c | contains($r))) | not))
                else . end
                | select((.hooks | type) != "array" or (.hooks | length) > 0))
            else . end)
          | with_entries(select((.value | type) != "array" or (.value | length) > 0)))
        | if .hooks == {} then del(.hooks) else . end
      else . end
  '
else
  # No jq (fresh-machine bootstrap, before ansible installs it). $managed is a
  # dot-path map, not valid settings.json, so we cannot expand it here — pass the
  # current file through unchanged; the next apply (jq present) enforces the keys.
  printf '%s\n' "$existing"
fi
