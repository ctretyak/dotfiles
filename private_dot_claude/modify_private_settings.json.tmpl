#!/bin/bash
# chezmoi modify_ script for ~/.claude/settings.json.
#
# Rather than owning the whole file, chezmoi enforces only a managed subset of keys
# and leaves everything else machine-local. This lets each machine keep its own
# settings.json while a core set of keys stays synced from chezmoi.
#
# Notably, "enabledPlugins" is deliberately NOT managed: ansible
# (claude-code-plugins.yml) is the single source of truth for plugins and the
# `claude plugin install` CLI writes the enablement into settings.json locally.
# The merge below preserves whatever the machine has there.
#
# chezmoi passes the current target contents on stdin (empty on a fresh machine)
# and writes this script's stdout back to ~/.claude/settings.json.
set -euo pipefail

# The keys chezmoi owns and syncs across every machine. Anything not listed here
# (enabledPlugins, extraKnownMarketplaces, MCP servers, per-machine permissions, …)
# is left untouched.
managed=$(cat <<'JSON'
{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "500000"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.claude/english-coach/coach-hook.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.config/tmux/plugins/tmux-agents-inbox/hooks/inbox-hook.sh PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.claude/english-coach/coach-precompute.sh",
            "timeout": 30,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.config/tmux/plugins/tmux-agents-inbox/hooks/inbox-hook.sh UserPromptSubmit",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.claude/english-coach/coach-hook.sh",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.config/tmux/plugins/tmux-agents-inbox/hooks/inbox-hook.sh Stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.config/tmux/plugins/tmux-agents-inbox/hooks/inbox-hook.sh SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.config/tmux/plugins/tmux-agents-inbox/hooks/inbox-hook.sh Notification",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.config/tmux/plugins/tmux-agents-inbox/hooks/inbox-hook.sh SessionEnd",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.config/tmux/plugins/tmux-agents-inbox/hooks/inbox-hook.sh PreCompact",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.config/tmux/plugins/tmux-agents-inbox/hooks/inbox-hook.sh PostToolUse",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "refreshInterval": 120
  },
  "language": "English",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "skipAutoPermissionPrompt": true
}
JSON
)

existing="$(cat)"
[ -z "$existing" ] && existing='{}'

if command -v jq >/dev/null 2>&1; then
  # Apply an explicit, per-property rule. A property that is never referenced below
  # (enabledPlugins, extraKnownMarketplaces, mcpServers, …) is left exactly as the
  # machine has it. "merge" keeps machine-local sibling keys; "replace" overwrites
  # the whole value.
  printf '%s' "$existing" | jq --argjson managed "$managed" '
      # env: enforce the managed vars, keep any other machine-local env var.
      .env = ((.env // {}) + $managed.env)

      # attribution: fully owned by chezmoi.
    | .attribution = $managed.attribution

      # permissions: enforce defaultMode only; keep machine-local allow/deny/ask
      # lists and additionalDirectories.
    | .permissions = ((.permissions // {}) + { defaultMode: $managed.permissions.defaultMode })

      # hooks: enforce the events chezmoi defines (each replaces that event whole);
      # keep any hook event chezmoi does not define.
    | .hooks = ((.hooks // {}) + $managed.hooks)

      # statusLine: fully owned by chezmoi.
    | .statusLine = $managed.statusLine

      # global preferences: replace outright.
    | .language = $managed.language
    | .skipWorkflowUsageWarning = $managed.skipWorkflowUsageWarning
    | .theme = $managed.theme
    | .skipAutoPermissionPrompt = $managed.skipAutoPermissionPrompt
  '
else
  # No jq yet (fresh-machine bootstrap, before ansible installs it). Emit the managed
  # set as-is; the next apply — with jq present — merges machine-local keys back in.
  printf '%s\n' "$managed"
fi
