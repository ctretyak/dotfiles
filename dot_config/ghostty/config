font-family = JetBrainsMono Nerd Font
font-size = 11

theme = Rose Pine

window-decoration = none
window-padding-x = 0
window-padding-y = 0

cursor-style = block
cursor-style-blink = false

scrollback-limit = 10000000

# Copy/paste on Russian layout — bind to Cyrillic chars at the physical V/C keys
keybind = ctrl+shift+м=paste_from_clipboard
keybind = ctrl+shift+с=copy_to_clipboard
