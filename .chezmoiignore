# OS partitioning. Each block lists paths to IGNORE unless its condition holds,
# using the form: {{ "{{ if not <keep-condition> }}" }} ... {{ "{{ end }}" }}

# Windows
{{ if ne .chezmoi.os "windows" }}
.chezmoiscripts/windows/**
AppData/**
.ansible/tasks/windows
{{ end }}

# Windows-only exclusions (these are Unix-like configs)
{{ if eq .chezmoi.os "windows" }}
.ansible
.chezmoiscripts/*.sh
.config
.gnupg
.local
.p10k.zsh
.zshrc
.zshrc_custom
git
{{ end }}

# macOS
{{ if ne .chezmoi.os "darwin" }}
.ansible/tasks/darwin
.chezmoiscripts/darwin/**
.config/iterm2
.aerospace.toml
Library
{{ end }}

# Linux — common tree (all distros)
{{ if ne .chezmoi.os "linux" }}
.ansible/tasks/linux
.chezmoiscripts/linux/**
{{ end }}

# Linux — per-distro: keep a distro's tasks/scripts/configs only on that distro
{{ if not (and (eq .chezmoi.os "linux") (eq .os.idLike "arch")) }}
.ansible/tasks/arch
.chezmoiscripts/linux/arch/**
.config/fontconfig
.config/chrome-flags.conf
.config/environment.d
{{ end }}
{{ if not (and (eq .chezmoi.os "linux") (eq .os.idLike "pop")) }}
.ansible/tasks/pop
.chezmoiscripts/linux/pop/**
.config/cosmic
{{ end }}
{{ if not (and (eq .chezmoi.os "linux") (eq .os.idLike "fedora")) }}
.ansible/tasks/fedora
.chezmoiscripts/linux/fedora/**
{{ end }}
{{ if not (and (eq .chezmoi.os "linux") (eq .os.idLike "kinoite")) }}
.ansible/tasks/kinoite
.chezmoiscripts/linux/kinoite/**
{{ end }}
{{ if not (and (eq .chezmoi.os "linux") (eq .os.idLike "aurora")) }}
